# Port for the Social Growth Control Center
PORT=3000

# Gemini API Key for Reasoning & Intent Scoring (Optional - system falls back to heuristic reasoning if not set)
GEMINI_API_KEY=

# Default Target Niche (E-commerce / SaaS / Product Sales)
NICHE_TARGET="E-commerce, SaaS, and Digital Product Sales"

# Headless mode for browser automation (false = visible browser, true = background)
HEADLESS=false

# Safety & Anti-Ban Rate Limits
DAILY_MAX_COMMENTS=20
DAILY_MAX_DMS=10
MIN_ACTION_DELAY_SEC=8
MAX_ACTION_DELAY_SEC=20
